# MinIO Root Credentials
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# PostgreSQL Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=

# Keycloak Configuration for Storage Service
KEYCLOAK_HTTPS_PORT=8443
KC_ISSUER_URI=https://localhost:8443/realms/mail-and-media-shop-realm
KC_CLIENT_ID=storage-service-app
KC_JWK_SET_URI=
FRONTEND_ORIGIN=http://localhost:5173

# Avatar Size Limits
AVATAR_MAX_FILE_SIZE=5MB
AVATAR_MAX_REQUEST_SIZE=5MB

# Keycloak Configuration for E2E Tests
# (These should match your Keycloak setup or the setup in scripts/docker-compose.yml)
KC_URL=https://localhost:8443
KC_REALM=mail-and-media-shop-realm
KC_CLIENT_SECRET=
KC_GRANT_TYPE=
KC_ADMIN_USER=
KC_ADMIN_PASS=
USER_EMAIL=
USER_PASSWORD=

# Storage Service E2E Test Configuration
STORAGE_APP_HOST=http://localhost
STORAGE_APP_PORT=8080

# Keycloak Database Configuration (for E2E tests in scripts/docker-compose.yml)
# Note: Storage Service uses port 5437 for Keycloak DB to avoid conflicts with API Project (5435/5436)
KEYCLOAK_DB_PORT=5437
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_IMAGE_VERSION=15-alpine

# Docker Network Configuration
# This network connects services for E2E tests (isolated from API project)
MONITORING_NETWORK_NAME=storage-service-mail-and-media-shop-v2_monitoring
